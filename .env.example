# Ce fichier documente les variables Firebase nécessaires.
# En local, créez un fichier .env à la racine du projet.
# NB: ce projet est séparé de NiyaJobs — ne jamais réutiliser le même .env.
#
# Où trouver ces valeurs : Firebase Console > Paramètres du projet (icône
# engrenage) > tes applications enregistrées > icône de configuration de
# chaque appli (Web </> ou Android). Le projectId est visible en haut de la
# page (ex: atelier-pro-1a9e8), identique pour toutes les plateformes.

# Valeurs communes (obligatoires)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# App Web (icône </> dans Firebase Console)
# FIREBASE_WEB_MEASUREMENT_ID est facultative.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_CLIENT_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# App Android (icône Android dans Firebase Console)
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# App iOS (si/quand ajoutée dans Firebase Console)
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
