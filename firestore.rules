rules_version = '2';

// Règles de sécurité Firestore — AtelierPro
// Principe : chaque document (atelier, client, commande, paiement, fiche)
// n'est lisible/modifiable que par son propriétaire (`userId` == uid connecté).

service cloud.firestore {
  match /databases/{database}/documents {

    match /ateliers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /clients/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /commandes/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /paiements/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /fiches/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
