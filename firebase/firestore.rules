rules_version = '2';

// Règles de sécurité Firestore — AtelierPro
// À coller dans Firebase Console > Firestore Database > Règles, ou déployer
// via `firebase deploy --only firestore:rules` si la CLI Firebase est configurée.
//
// Principe : chaque document (atelier, client, commande, paiement, fiche)
// n'est lisible/modifiable que par son propriétaire (`userId` == uid connecté).
// L'atelier est indexé directement par l'uid (pas de champ userId séparé à
// vérifier, l'ID du document EST l'uid).

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper pour vérifier si l'utilisateur est propriétaire du document.
    // Supporte à la fois camelCase (userId) et snake_case (user_id) pour la transition.
    function isOwner(data) {
      return request.auth != null && (
        request.auth.uid == data.userId ||
        request.auth.uid == data.user_id
      );
    }

    match /ateliers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /clients/{docId} {
      allow read, update, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
    }

    match /commandes/{docId} {
      allow read, update, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
    }

    match /paiements/{docId} {
      allow read, update, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
    }

    match /fiches/{docId} {
      allow read, update, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
    }
  }
}
