rules_version = '2';

// Règles de sécurité Firebase Storage — AtelierPro
// À coller dans Firebase Console > Storage > Rules.
// Structure des fichiers : {dossier}/{userId}/{clé}.{ext}
//   - logos/{userId}/logo.jpg       (logo de l'atelier)
//   - photos/{userId}/{clientId}.jpg (photo d'un client)

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /logos/{userId}/{fileName} {
      allow read: if true; // logos publics (affichés sans authentification nécessaire)
      allow create, update: if isOwner(userId) && isValidUpload();
      allow delete: if isOwner(userId);
    }

    match /photos/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUpload();
      allow delete: if isOwner(userId);
    }

    match /commandes/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUpload();
      allow delete: if isOwner(userId);
    }

    match /modeles_etapes/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUpload();
      allow delete: if isOwner(userId);
    }
  }
}
